{
  "name": "dockerdesk",
  "version": "0.0.1",
  "description": "Docker Desk App",
  "productName": "DockerDesk",
  "author": "Reiner New <nbxlhc@hotmail.com>",
  "type": "module",
  "private": true,
  "requireAdmin": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "pwa:serve": "quasar dev -m pwa",
    "pwa:build": "quasar build -m pwa",
    "electron:serve": "quasar dev -m electron",
    "electron:build": "quasar build -m electron",
    "electron:buildbug": "quasar build -m electron --debug",
    "electron:rebuild": "npm rebuild better-sqlite3 --runtime=electron --target=35.2.0 --abi=127 --dist-url=electronjs.org/headers",
    "capacitor-android:Serve": "quasar dev -m capacitor -T android",
    "capacitor-android:build": "quasar build -m capacitor -T android --ide",
    "capacitor-ios:Serve": "quasar dev -m capacitor -T ios",
    "capacitor-ios:build": "quasar build -m capacitor -T ios",
    "postinstall": "quasar prepare",
    "fix": "electron-fix start"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^2.0.122",
