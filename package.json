{
  "name": "dockerdesk",
  "version": "0.0.1",
  "description": "Docker Desk App",
  "productName": "Docker Desk App",
  "author": "Reiner New <nbxlhc@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "pwa:serve": "quasar dev -m pwa",
    "pwa:build": "quasar build -m pwa -P always",
    "electron:serve": "quasar dev -m electron",
    "electron:build": "quasar build -m electron -P always",
    "capacitor-android:Serve": "quasar dev -m capacitor -T android",
    "capacitor-android:build": "quasar build -m capacitor -T android --ide",
    "capacitor-ios:Serve": "quasar dev -m capacitor -T ios",
    "capacitor-ios:build": "quasar build -m capacitor -T ios",
    "postinstall": "quasar prepare",
    "fix": "electron-fix start"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@quasar/extras": "^1.16.17",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.8.4",
    "crypto.js": "^3.3.4",
    "mobile-detect": "^1.4.5",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "quasar": "^2.18.1",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@eslint/js": "^9.25.1",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.2.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.10.0",
    "electron": "^35.2.0",
    "electron-log": "^5.3.4",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.25.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "knex": "^3.1.0",
    "node-pty": "1.1.0-beta13",
    "postcss": "^8.5.3",
    "prebuild-install": "^7.1.3",
    "prettier": "^3.5.3",
    "scp2": "^0.5.0",
    "ssh2": "^1.16.0",
    "telnet-client": "^2.2.5",
    "uuid": "^11.1.0",
    "vite-plugin-checker": "^0.9.1",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-require": "^1.2.14",
    "vite-plugin-require-transform": "^1.0.21",
    "workbox-build": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
